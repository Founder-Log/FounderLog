APP_NAME=FounderLog
DEBUG=true

# Postgres: одни и те же значения читают и docker-compose, и приложение
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=founderlog
POSTGRES_HOST=127.0.0.1
# Порт на хосте (левая часть проброса). Внутри контейнера всегда 5432.
POSTGRES_PORT=5433

JWT_SECRET=change-me-to-something-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30