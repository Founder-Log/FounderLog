# Скопируй этот файл в .env (он уже в .gitignore) и при желании поменяй значения.
# Значения ниже совпадают с дефолтами в docker-compose.yml — из коробки
# работает без правок.

APP_NAME=FounderLog
DEBUG=true

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# host=localhost — потому что приложение бежит локально (uvicorn),
# а Postgres — в докере, но с проброшенным на localhost портом 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/founderlog

JWT_SECRET=change-me-to-something-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Для docker-compose.yml — те же значения, но без "postgresql+asyncpg://"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=founderlog
